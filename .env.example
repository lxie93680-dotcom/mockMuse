# Default provider: kimi | deepseek | custom
LLM_PROVIDER=deepseek

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
# Kimi K2 defaults to non-thinking mode for this demo.
# KIMI_EXTRA_BODY={"thinking":{"type":"disabled"}}

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Any provider implementing OpenAI Chat Completions + function calling.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
# Custom requests send no provider-specific extra parameters by default.
# CUSTOM_EXTRA_BODY={}

# Choose a long random access token before remote access.
MUSE_ACCESS_TOKEN=replace-with-a-long-random-token
MUSE_DATA_DIR=data

# Dedicated Linux execution service (never falls back to the local host).
# On the cloud Linux machine, publish the worker on loopback only.
MUSE_LINUX_URL=http://127.0.0.1:8765
MUSE_LINUX_TOKEN=

# Local stdio MCP; install vendor packages first. No remote login required.
MUSE_FILESYSTEM_MCP=1

MUSE_MAX_TURNS=100

# Browser driver: playwright (semantic actions) or extension (legacy rollback)
MUSE_BROWSER_BACKEND=playwright
# Optional absolute Node.js executable; supports Windows paths with spaces (no wrapping quotes).
# MUSE_NODE_EXECUTABLE=C:/Program Files/nodejs/node.exe
# Dedicated Chromium is auto-discovered per OS; PLAYWRIGHT_BROWSERS_PATH overrides its cache root.
# Persistent dedicated Chrome for Testing; existing login state is not imported
# MUSE_PLAYWRIGHT_EXECUTABLE=/absolute/path/to/Chrome-for-Testing
MUSE_PLAYWRIGHT_HEADLESS=0
# Optional externally managed CDP endpoint (requires that browser to be configured)
# MUSE_PLAYWRIGHT_CDP_ENDPOINT=ws://127.0.0.1:9222/devtools/browser/...

# extension connects to existing ordinary Chrome via official Playwright extension
MUSE_PLAYWRIGHT_CONNECTION=extension
# Optional specific Chrome profile directory, e.g. Default or Profile 1
# MUSE_PLAYWRIGHT_PROFILE_DIR=Default

# macOS 无法读取 Chrome 配置目录时，显式指定普通 Chrome
# MUSE_PLAYWRIGHT_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional external plugin/HTTP source config; manifest paths are relative to this file.
# MUSE_TOOL_SOURCES_CONFIG=/absolute/path/to/tool-sources.json
