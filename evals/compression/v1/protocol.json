{
  "version": "muse-compression-v1",
  "date": "2026-10-15",
  "status": "implemented_offline_validated_live_not_run",
  "scope": "forced Muse compression kernel + no-tool reader QA; production trigger/lifecycle tested separately",
  "axes": [
    "efficiency",
    "downstream_context_understanding"
  ],
  "groups": [
    "full",
    "compressed",
    "tail_approximately_equal_estimated_budget"
